            {
              "quizId": "quiz_sample_1",
              "question": "Which of the following is a fundamental physical quantity?",
              "optionA": "Velocity",
              "optionB": "Time",
              "optionC": "Force",
              "optionD": "Work",
              "correctAnswer": "B"
            },
